# Copy to .env.local for local development, and set the same variables in your
# hosting provider (Vercel: Project Settings, Environment Variables).
# Never commit real secrets. Variables prefixed NEXT_PUBLIC_ are sent to the browser.

# --- Site --------------------------------------------------------------------
# Public URL of the deployment, used in alert emails. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=

# --- Market data -------------------------------------------------------------
# Optional. CoinGecko works keyless with public rate limits (often throttled on
# shared hosting IPs). A free Demo key is recommended in production:
# https://www.coingecko.com/en/api/pricing
COINGECKO_DEMO_API_KEY=
# Optional. A Pro key additionally unlocks the historical total-market-cap chart.
COINGECKO_PRO_API_KEY=

# --- Supabase (accounts, sync, alerts) ----------------------------------------
# Project Settings, API. The URL and publishable (anon) key are public by design:
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: secret (service role) key, used exclusively by /api/cron/alerts.
SUPABASE_SECRET_KEY=

# --- Research Copilot (OpenAI) -------------------------------------------------
OPENAI_API_KEY=
# Optional, defaults to gpt-5.4-mini.
OPENAI_MODEL=
# Optional: signs the guest quota cookie. Falls back to CRON_SECRET.
COPILOT_COOKIE_SECRET=

# --- Alert emails (Resend) ---------------------------------------------------------
RESEND_API_KEY=
# Sender on a domain verified in Resend.
RESEND_FROM="Sensitor <alerts@notif.govera.fr>"

# --- Alert scheduler -------------------------------------------------------------
# Random string (openssl rand -hex 32). The scheduler calls /api/cron/alerts with
# the header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Planned (not used yet) --------------------------------------------------------
# Phase 4, subscriptions
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
