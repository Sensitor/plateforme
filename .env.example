# --- Market data -----------------------------------------------------------
# Optional. CoinGecko works keyless with public rate limits (often throttled on
# shared hosting IPs). A free Demo key is recommended in production:
# https://www.coingecko.com/en/api/pricing
COINGECKO_DEMO_API_KEY=
# Optional. A Pro key additionally unlocks the historical total-market-cap chart.
COINGECKO_PRO_API_KEY=

